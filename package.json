{
  "name": "arbuild",
  "version": "0.1.0",
  "private": true,
  "description": "A small dig site on your table, in passthrough AR on a Meta Quest 3: drive the excavator, dig, and heap up the earth. WebXR, three.js and Vite.",
  "keywords": ["webxr", "augmented-reality", "threejs", "meta-quest", "pwa"],
  "homepage": "https://ariamokr.github.io/arbuild/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/arbuild.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/arbuild/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node.mjs",
    "build": "vite build && node scripts/sw-dist.mjs",
    "icons": "python scripts/make-icons.py",
    "prepreview": "node scripts/check-node.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "pretest:e2e": "node scripts/check-node.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@iwer/sem": "^2.5.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "iwer": "^2.5.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
